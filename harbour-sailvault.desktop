[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-sailvault
Exec=harbour-sailvault
Name=SailVault

[X-Sailjail]
# Changing OrganizationName or ApplicationName moves the app's data
# directories, so keep both stable once released.
OrganizationName=de.tordenskjold
ApplicationName=sailvault
Permissions=Documents;Downloads
